// Menu, accelerators and version information, after the Eureka A4 emulator's
// eureka.rc, so that a user who knows that program finds the same keys here.
//
// The strings here are Czech and the file is UTF-8, so windres is called with
// --codepage=65001 (see the Makefile).  Resources hold UTF-16 either way.

#include <windows.h>
#include "resource.h"
// Generated by the Makefile from git describe.
#include "aria_version.h"

#pragma code_page(65001)

// The manifest asks for Common Controls 6 and system DPI awareness.
1 RT_MANIFEST "aria.manifest"

/////////////////////////////////////////////////////////////////////////////
// Version
//
// What Explorer shows under Properties -> Details.  Czech, Unicode
// (040504B0).

1 VERSIONINFO
FILEVERSION     ARIA_FILEVERSION
PRODUCTVERSION  ARIA_FILEVERSION
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040504B0"
        BEGIN
            VALUE "FileDescription", "Emulátor Robotron Aria"
            VALUE "ProductName", "Aria Emulator"
            VALUE "FileVersion", ARIA_VERSION_TEXT
            VALUE "ProductVersion", ARIA_VERSION_TEXT
            VALUE "OriginalFilename", "AriaEmulator.exe"
            VALUE "LegalCopyright", "Copyright (c) 2026 Aria Emulator contributors, MIT"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0405, 1200
    END
END

/////////////////////////////////////////////////////////////////////////////
// Menu
//
// Every command that has a shortcut names it after the tab, because that is
// where a screen reader looks for it.  A shortcut nobody can discover is a
// shortcut nobody has.  Only commands that already do something are here: an
// item that answers with nothing is a silent dead end.

IDR_MAIN_MENU MENU
BEGIN
    POPUP "&Soubor"
    BEGIN
        MENUITEM "&Konec\tF11, Ctrl+Q",                         ID_FILE_EXIT
    END
    /* As the Eureka emulator's Disketa, and second like it: the slot holds
       an SRAM card made from a folder, written back when it comes out, or
       one kept in an image file (HANDOFF 6.8). The folder comes first: it
       is how files get to the Aria. */
    POPUP "K&arta"
    BEGIN
        MENUITEM "&Vložit kartu ze složky…\tF11, Ctrl+I",       ID_CARD_INSERT
        MENUITEM "Vložit kartu z &obrazu…\tF11, Ctrl+O",        ID_CARD_INSERT_IMAGE
        MENUITEM "Vložit &novou kartu…\tF11, Ctrl+M",           ID_CARD_NEW
        MENUITEM "V&ysunout kartu\tF11, Ctrl+0",                ID_CARD_EJECT
        MENUITEM "&Zamknout proti zápisu\tF11, Ctrl+Z",         ID_CARD_PROTECT
        MENUITEM SEPARATOR
        /* As in the Eureka's Disketa: no shortcut for an act done now and
           then, and the nine slots last, so they are not walked past on the
           way to everything else. Their text is rewritten from the settings
           whenever the menu opens (RefreshSlotItems); what stands here is
           what an empty slot says. */
        MENUITEM "&Spravovat sloty…",                           ID_CARD_SLOTS
        MENUITEM "&1 (prázdný)\tF11, Ctrl+1",                   40071
        MENUITEM "&2 (prázdný)\tF11, Ctrl+2",                   40072
        MENUITEM "&3 (prázdný)\tF11, Ctrl+3",                   40073
        MENUITEM "&4 (prázdný)\tF11, Ctrl+4",                   40074
        MENUITEM "&5 (prázdný)\tF11, Ctrl+5",                   40075
        MENUITEM "&6 (prázdný)\tF11, Ctrl+6",                   40076
        MENUITEM "&7 (prázdný)\tF11, Ctrl+7",                   40077
        MENUITEM "&8 (prázdný)\tF11, Ctrl+8",                   40078
        MENUITEM "&9 (prázdný)\tF11, Ctrl+9",                   40079
    END
    POPUP "S&troj"
    BEGIN
        MENUITEM "&Reset (odpojit baterii)…\tF11, Ctrl+R",     ID_MACHINE_RESET
        MENUITEM "T&eplý reset\tF11, Ctrl+P",                   ID_MACHINE_POWERON
        MENUITEM "&Vypnout Arii\tF11, Ctrl+V",                  ID_MACHINE_POWEROFF
    END
    POPUP "&Klávesnice"
    BEGIN
        MENUITEM "&Uvolnit klávesnici\tShift+F11",              ID_KEYBOARD_RELEASE
        MENUITEM "&Jedna klávesa do Windows nebo zkratka\tF11", ID_KEYBOARD_PASSONCE
        MENUITEM SEPARATOR
        /* No shortcut, as in Eureka's submenu: every host shortcut is a key
           the Aria never gets again.  The mnemonics reach it in four keys:
           F12, K, P, K. */
        POPUP "&Poslat Arii klávesu"
        BEGIN
            MENUITEM "&Konec (všechny čtyři šipky)",            ID_KEYBOARD_SEND_KONEC
        END
    END
    POPUP "&Nápověda"
    BEGIN
        MENUITEM "&Klávesové zkratky…\tF11, Ctrl+H",            ID_HELP_KEYS
        MENUITEM "&O programu…",                                ID_HELP_ABOUT
    END
END

// IDR_ACCELERATORS is always in force and is the whole permanent cost.  F12
// opens the menu bar, as in the Eureka emulator, and Alt and F10 do not:
// the window swallows them while the Aria has the keyboard, so that a stray
// Alt cannot drop the user into a menu in silence.  None of the three keys
// is the Aria's: its keyboard has F1-F8 only (BKB.COM, HANDOFF 6.4).

IDR_ACCELERATORS ACCELERATORS
BEGIN
    VK_F11,     ID_KEYBOARD_PASSONCE, VIRTKEY
    VK_F11,     ID_KEYBOARD_RELEASE,  VIRTKEY, SHIFT
    VK_F12,     ID_ACTIVATE_MENU,     VIRTKEY
END

// IDR_ACCELERATORS_HOST is in force only while the keyboard is the host's:
// after F11 (one key to Windows) or Shift+F11 (let go of it altogether).  The
// rest of the time Ctrl with a letter is not a shortcut at all, which matters
// more here than on the Eureka: D, K and L are dots of the braille keyboard.
//
// Keep every entry Ctrl+something, for the reason the Eureka's .rc gives at
// length: the window never sees an accelerator's press, so a bare key here
// could leave F11 armed with nothing to spend it.

IDR_ACCELERATORS_HOST ACCELERATORS
BEGIN
    "Q",        ID_FILE_EXIT,        VIRTKEY, CONTROL
    "R",        ID_MACHINE_RESET,    VIRTKEY, CONTROL
    "P",        ID_MACHINE_POWERON,  VIRTKEY, CONTROL
    "V",        ID_MACHINE_POWEROFF, VIRTKEY, CONTROL
    "H",        ID_HELP_KEYS,        VIRTKEY, CONTROL
    "I",        ID_CARD_INSERT,      VIRTKEY, CONTROL
    "O",        ID_CARD_INSERT_IMAGE, VIRTKEY, CONTROL
    "M",        ID_CARD_NEW,         VIRTKEY, CONTROL
    "1",        40071,               VIRTKEY, CONTROL
    "2",        40072,               VIRTKEY, CONTROL
    "3",        40073,               VIRTKEY, CONTROL
    "4",        40074,               VIRTKEY, CONTROL
    "5",        40075,               VIRTKEY, CONTROL
    "6",        40076,               VIRTKEY, CONTROL
    "7",        40077,               VIRTKEY, CONTROL
    "8",        40078,               VIRTKEY, CONTROL
    "9",        40079,               VIRTKEY, CONTROL
    "0",        ID_CARD_EJECT,       VIRTKEY, CONTROL
    "Z",        ID_CARD_PROTECT,     VIRTKEY, CONTROL
END


/* The card's size, asked when a folder goes in: real card sizes the folder
   fits on (FolderCard::FittingSizes). The label carries what the folder
   takes, so the screen reader reads it with the list. */
IDD_CARD_SIZE DIALOGEX 0, 0, 240, 112
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Velikost karty"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Velikost karty:", IDC_CARD_SIZE_LABEL, 7, 7, 226, 20
    LISTBOX         IDC_CARD_SIZES, 7, 29, 226, 58, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 129, 91, 50, 14
    PUSHBUTTON      "Storno", IDCANCEL, 183, 91, 50, 14
END

/* A new card, after the Eureka emulator's Nová disketa: one page, the kind
   and the size, and where it goes is asked next by the shell's own picker,
   a folder to create or a file to write. Every size is offered, since there
   is nothing on the card yet. The unformatted kind is all FFh; the Aria
   refuses to write to it until it is formatted (boot_test). */
IDD_CARD_NEW DIALOGEX 0, 0, 260, 164
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Nová karta"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Jaká karta", IDC_STATIC, 7, 7, 246, 62
    CONTROL         "Nová prázdná &složka", IDC_CARD_NEW_FOLDER, "Button",
                    BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 16, 19, 230, 10
    CONTROL         "&Obraz karty, naformátovaný", IDC_CARD_NEW_IMAGE, "Button",
                    BS_AUTORADIOBUTTON, 16, 31, 230, 10
    CONTROL         "Obraz karty, &nenaformátovaný — naformátuje ho Aria",
                    IDC_CARD_NEW_BLANK, "Button", BS_AUTORADIOBUTTON, 16, 43, 230, 10
    /* Only unformatted: the FTL is DLFFSA's to lay down (HANDOFF 6.8). */
    CONTROL         "&Fleš karta, nenaformátovaná — naformátuje ji Aria",
                    IDC_CARD_NEW_FLASH, "Button", BS_AUTORADIOBUTTON, 16, 55, 230, 10
    LTEXT           "&Velikost karty:", IDC_STATIC, 7, 75, 246, 9
    LISTBOX         IDC_CARD_NEW_SIZES, 7, 86, 246, 54, LBS_NOTIFY | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 149, 143, 50, 14, WS_GROUP
    PUSHBUTTON      "Storno", IDCANCEL, 203, 143, 50, 14
END

/* The slots, after the Eureka emulator's "Sloty s disketami": a list that
   carries the slot number (the shortcut) and the lock in every line, the
   buttons that point a slot somewhere, and the lock of the selected slot's
   card. WS_GROUP on the first button and on the box, so the arrows walk the
   buttons among themselves and never into the list. No button for an
   unsaved card: every card here has a folder or a file. */
IDD_CARD_SLOTS DIALOGEX 0, 0, 300, 190
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sloty s kartami"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Sloty:", IDC_STATIC, 7, 7, 286, 9
    LISTBOX         IDC_SLOT_LIST, 7, 19, 286, 90, LBS_NOTIFY | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "&Přiřadit složku…", IDC_SLOT_FOLDER, 7, 115, 138, 14, WS_GROUP
    PUSHBUTTON      "Přiřadit &obraz…", IDC_SLOT_IMAGE, 155, 115, 138, 14
    PUSHBUTTON      "Sem &vloženou kartu", IDC_SLOT_CURRENT, 7, 133, 138, 14
    PUSHBUTTON      "Vyprázdnit s&lot", IDC_SLOT_CLEAR, 155, 133, 138, 14
    AUTOCHECKBOX    "&Zamknout tuto kartu proti zápisu", IDC_SLOT_LOCK, 7, 155, 286, 10,
                    BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 186, 169, 50, 14, WS_GROUP
    PUSHBUTTON      "Storno", IDCANCEL, 243, 169, 50, 14
END
