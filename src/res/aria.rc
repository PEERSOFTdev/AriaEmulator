// Menu, accelerators and version information, after the Eureka A4 emulator's
// eureka.rc, so that a user who knows that program finds the same keys here.
//
// The strings here are Czech and the file is UTF-8, so windres is called with
// --codepage=65001 (see the Makefile).  Resources hold UTF-16 either way.

#include <windows.h>
#include "resource.h"
// Generated by the Makefile from git describe.
#include "aria_version.h"

#pragma code_page(65001)

// The manifest asks for Common Controls 6 and system DPI awareness.
1 RT_MANIFEST "aria.manifest"

/////////////////////////////////////////////////////////////////////////////
// Version
//
// What Explorer shows under Properties -> Details.  Czech, Unicode
// (040504B0).

1 VERSIONINFO
FILEVERSION     ARIA_FILEVERSION
PRODUCTVERSION  ARIA_FILEVERSION
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040504B0"
        BEGIN
            VALUE "FileDescription", "Emulátor Robotron Aria"
            VALUE "ProductName", "Aria Emulator"
            VALUE "FileVersion", ARIA_VERSION_TEXT
            VALUE "ProductVersion", ARIA_VERSION_TEXT
            VALUE "OriginalFilename", "AriaEmulator.exe"
            VALUE "LegalCopyright", "Copyright (c) 2026 Aria Emulator contributors, MIT"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0405, 1200
    END
END

/////////////////////////////////////////////////////////////////////////////
// Menu
//
// Every command that has a shortcut names it after the tab, because that is
// where a screen reader looks for it.  A shortcut nobody can discover is a
// shortcut nobody has.  Only commands that already do something are here: an
// item that answers with nothing is a silent dead end.

IDR_MAIN_MENU MENU
BEGIN
    POPUP "&Soubor"
    BEGIN
        MENUITEM "&Konec\tF11, Ctrl+Q",                         ID_FILE_EXIT
    END
    /* As the Eureka emulator's Disketa, and second like it: the slot holds
       an SRAM card made from a folder, written back when it comes out
       (HANDOFF 6.8). */
    POPUP "K&arta"
    BEGIN
        MENUITEM "&Vložit kartu ze složky…\tF11, Ctrl+I",       ID_CARD_INSERT
        MENUITEM "V&ysunout kartu\tF11, Ctrl+0",                ID_CARD_EJECT
        MENUITEM "&Zamknout proti zápisu\tF11, Ctrl+Z",         ID_CARD_PROTECT
    END
    POPUP "S&troj"
    BEGIN
        MENUITEM "&Reset (odpojit baterii)…\tF11, Ctrl+R",     ID_MACHINE_RESET
        MENUITEM "T&eplý reset\tF11, Ctrl+P",                   ID_MACHINE_POWERON
        MENUITEM "&Vypnout Arii\tF11, Ctrl+V",                  ID_MACHINE_POWEROFF
    END
    POPUP "&Klávesnice"
    BEGIN
        MENUITEM "&Uvolnit klávesnici\tShift+F11",              ID_KEYBOARD_RELEASE
        MENUITEM "&Jedna klávesa do Windows nebo zkratka\tF11", ID_KEYBOARD_PASSONCE
        MENUITEM SEPARATOR
        /* No shortcut, as in Eureka's submenu: every host shortcut is a key
           the Aria never gets again.  The mnemonics reach it in four keys:
           F12, K, P, K. */
        POPUP "&Poslat Arii klávesu"
        BEGIN
            MENUITEM "&Konec (všechny čtyři šipky)",            ID_KEYBOARD_SEND_KONEC
        END
    END
    POPUP "&Nápověda"
    BEGIN
        MENUITEM "&Klávesové zkratky…\tF11, Ctrl+H",            ID_HELP_KEYS
        MENUITEM "&O programu…",                                ID_HELP_ABOUT
    END
END

// IDR_ACCELERATORS is always in force and is the whole permanent cost.  F12
// opens the menu bar, as in the Eureka emulator, and Alt and F10 do not:
// the window swallows them while the Aria has the keyboard, so that a stray
// Alt cannot drop the user into a menu in silence.  None of the three keys
// is the Aria's: its keyboard has F1-F8 only (BKB.COM, HANDOFF 6.4).

IDR_ACCELERATORS ACCELERATORS
BEGIN
    VK_F11,     ID_KEYBOARD_PASSONCE, VIRTKEY
    VK_F11,     ID_KEYBOARD_RELEASE,  VIRTKEY, SHIFT
    VK_F12,     ID_ACTIVATE_MENU,     VIRTKEY
END

// IDR_ACCELERATORS_HOST is in force only while the keyboard is the host's:
// after F11 (one key to Windows) or Shift+F11 (let go of it altogether).  The
// rest of the time Ctrl with a letter is not a shortcut at all, which matters
// more here than on the Eureka: D, K and L are dots of the braille keyboard.
//
// Keep every entry Ctrl+something, for the reason the Eureka's .rc gives at
// length: the window never sees an accelerator's press, so a bare key here
// could leave F11 armed with nothing to spend it.

IDR_ACCELERATORS_HOST ACCELERATORS
BEGIN
    "Q",        ID_FILE_EXIT,        VIRTKEY, CONTROL
    "R",        ID_MACHINE_RESET,    VIRTKEY, CONTROL
    "P",        ID_MACHINE_POWERON,  VIRTKEY, CONTROL
    "V",        ID_MACHINE_POWEROFF, VIRTKEY, CONTROL
    "H",        ID_HELP_KEYS,        VIRTKEY, CONTROL
    "I",        ID_CARD_INSERT,      VIRTKEY, CONTROL
    "0",        ID_CARD_EJECT,       VIRTKEY, CONTROL
    "Z",        ID_CARD_PROTECT,     VIRTKEY, CONTROL
END


/* The card's size, asked when a folder goes in: real card sizes the folder
   fits on (FolderCard::FittingSizes). The label carries what the folder
   takes, so the screen reader reads it with the list. */
IDD_CARD_SIZE DIALOGEX 0, 0, 240, 112
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Velikost karty"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Velikost karty:", IDC_CARD_SIZE_LABEL, 7, 7, 226, 20
    LISTBOX         IDC_CARD_SIZES, 7, 29, 226, 58, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 129, 91, 50, 14
    PUSHBUTTON      "Storno", IDCANCEL, 183, 91, 50, 14
END
